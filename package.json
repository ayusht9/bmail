{
  "name": "bmail",
  "author": "Ayush Kumar",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:desktop:setup": "tauri build --config src-tauri/tauri.setup-test.conf.json --no-bundle && node scripts/test-desktop-setup.cjs",
    "test:desktop:lifecycle": "tauri build --debug --config src-tauri/tauri.lifecycle-test.conf.json --no-bundle && node scripts/test-desktop-lifecycle.cjs",
    "test:profiles": "node scripts/test-profiles.cjs",
    "verify": "node engine/backup.cjs --verify",
    "test:stats:ui": "node scripts/test-stats-ui.cjs",
    "test:search:ui": "node scripts/test-mail-search.cjs",
    "test:cache": "cargo test --manifest-path src-tauri/Cargo.toml --lib cache::tests",
    "test:mailbox-removal": "tauri build --debug --config src-tauri/tauri.setup-test.conf.json --no-bundle && node scripts/test-mailbox-removal.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "imapflow": "^2.10.0",
    "libmime": "^5.6.3",
    "mailparser": "^3.14.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "playwright-core": "^1.65.1",
    "vite": "^7.1.7"
  }
}
