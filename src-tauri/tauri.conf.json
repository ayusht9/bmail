{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mail Vault",
  "version": "0.1.1",
  "identifier": "in.co.integramicro.mail-vault",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Mail Vault",
      "width": 1120,
      "height": 780,
      "minWidth": 760,
      "minHeight": 620,
      "center": true
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "targets": ["nsis"],
    "resources": { "resources/engine/": "engine/" },
    "shortDescription": "Local read-only email backup dashboard",
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English"] },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
