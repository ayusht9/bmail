{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bmail",
  "version": "0.4.0",
  "identifier": "com.bmail.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:runtime && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "$LOCALDATA/Bmail",
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Bmail",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "center": true
      },
      {
        "label": "splashscreen",
        "url": "splash.html",
        "title": "Starting Bmail",
        "width": 440,
        "height": 340,
        "center": true,
        "decorations": false,
        "resizable": false,
        "closable": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/engine/": "engine/"
    },
    "shortDescription": "Local read-only email backup dashboard",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
